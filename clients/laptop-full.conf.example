# Laptop — FULL tunnel profile
#
# All traffic exits through the VPS public IP. Use this on untrusted / public Wi-Fi.
# IPv6 is blocked while the tunnel is up, so it can neither leak nor hang.
#
# Install as /etc/wireguard/casa-full.conf with permissions 600.
# Bring up with:  sudo wg-quick up casa-full
#
# NEVER commit the real file: it contains the private key.

[Interface]
Address = 10.10.0.12/32
PrivateKey = <LAPTOP_PRIVATE_KEY>

# In a full tunnel EVERYTHING goes through the tunnel, DNS included. Without an
# explicit resolver, queries could leak to the local network's DNS or fail once the
# original resolver is no longer reachable. See the DNS note at the bottom.
#
# Pointing this at the Pi's VPN address sends DNS queries through the tunnel to
# Pi-hole, so ad blocking works away from home with no app installed, and no public
# resolver sees the browsing history. Use a public resolver (e.g. 1.1.1.1) instead if
# Pi-hole is not deployed.
DNS = 10.10.0.2

# IPv6 handling.
# AllowedIPs = 0.0.0.0/0 only captures IPv4, so IPv6 traffic would bypass the tunnel.
# But wg-quick's kill-switch drops it instead of letting it leak — which is worse than
# either option: the browser resolves an AAAA record, tries to connect, and hangs until
# the timeout expires. Sites with IPv6 (WhatsApp, many CDNs) appear to freeze while
# IPv4-only sites load fine.
#
# The fix is to reject IPv6 explicitly so the browser fails instantly and falls back to
# IPv4, using a dedicated nftables table rather than a global sysctl:
#   - Nothing outside this table is touched, so NetworkManager cannot revert it.
#   - It is atomic: the table either exists or it does not.
#   - PostDown removes it entirely, leaving no residue.
#
# An earlier attempt disabled IPv6 with `sysctl -w net.ipv6.conf.all.disable_ipv6=1`.
# That works until something re-enables it while the tunnel is still up, and then you
# are back to the hanging behaviour. See TROUBLESHOOTING.md issue 16.
PostUp   = nft add table inet wgblock6
PostUp   = nft add chain inet wgblock6 output { type filter hook output priority 0 \; policy accept \; }
PostUp   = nft add rule inet wgblock6 output meta nfproto ipv6 oifname != "casa-full" drop
PostDown = nft delete table inet wgblock6

[Peer]
PublicKey = <VPS_PUBLIC_KEY>
Endpoint = <VPS_PUBLIC_IP>:51820

# Route everything into the tunnel. This is what makes it a "full" tunnel and also
# makes wg-quick install a kill-switch (fwmark + policy routing + nftables rules).
AllowedIPs = 0.0.0.0/0

PersistentKeepalive = 25

# --- Verification ---
#
#   sudo wg show              # 'latest handshake' recent, fwmark present
#   curl -4 ifconfig.me       # must print the VPS public IP
#   curl -6 --max-time 5 ifconfig.me   # must fail FAST (blocked, not hanging)
#   cat /etc/resolv.conf      # must show the DNS set above
#   dig doubleclick.net +short   # 0.0.0.0 -> Pi-hole is filtering through the tunnel
#   dig google.com +short        # resolves normally
#
# 'dig' comes from the 'bind' package on Arch (bind9-dnsutils on Debian).
#
# The real test is a browser: sites with AAAA records (WhatsApp Web, most CDNs) must
# load in under a second or two, not stall.
#
# After bringing it down, confirm nothing was left behind:
#   sudo nft list tables | grep wgblock6     # gone
#   curl -6 ifconfig.me                      # native IPv6 works again
#   cat /etc/resolv.conf                     # back to the normal resolvers
#
# --- DNS note (Arch / NetworkManager) ---
#
# The DNS directive makes wg-quick call `resolvconf`. Two things are required:
#
#   1. Install the provider:
#        sudo pacman -S openresolv
#
#   2. Hand ownership of /etc/resolv.conf to resolvconf, otherwise NetworkManager keeps
#      rewriting the file and resolvconf refuses to touch it ("signature mismatch"):
#
#        # /etc/NetworkManager/conf.d/rc-manager.conf
#        [main]
#        dns=resolvconf
#        rc-manager=resolvconf
#
#        sudo systemctl restart NetworkManager
#        sudo resolvconf -u
#
#      `dns=` picks the backend; `rc-manager=` decides who owns the file. Setting only
#      the first one appears to work until the next reboot. Validate across a reboot:
#      /etc/resolv.conf must still say "Generated by resolvconf".
#
#      Rollback if DNS breaks:
#        sudo rm /etc/NetworkManager/conf.d/rc-manager.conf
#        sudo systemctl restart NetworkManager
#
# --- Kernel note ---
#
# The kill-switch rules need the nft_fib_ipv4 and nft_ct kernel modules. If `nft`
# reports "Could not process rule: No such file or directory", the running kernel
# probably no longer matches the modules on disk after an upgrade. Compare and reboot:
#   uname -r ; ls /usr/lib/modules/
