# Laptop — FULL tunnel profile
#
# All traffic exits through the VPS public IP. Use this on untrusted / public Wi-Fi.
# Includes IPv6 leak protection.
#
# Install as /etc/wireguard/casa-full.conf with permissions 600.
# Bring up with:  sudo wg-quick up casa-full
#
# NEVER commit the real file: it contains the private key.

[Interface]
Address = 10.10.0.12/32
PrivateKey = <LAPTOP_PRIVATE_KEY>

# In a full tunnel EVERYTHING goes through the tunnel, DNS included. Without an
# explicit resolver, queries could leak to the local network's DNS or fail once the
# original resolver is no longer reachable. See the DNS note at the bottom.
DNS = 1.1.1.1

# IPv6 leak protection.
# AllowedIPs = 0.0.0.0/0 only captures IPv4, so on a dual-stack network IPv6 traffic
# would bypass the tunnel entirely and expose the real address. Disabling IPv6 while
# the tunnel is up prevents that.
#
# These run as PostUp (not PreUp) on purpose: if wg-quick fails earlier (DNS, nftables,
# a bad key...) it aborts without ever running PostDown, which would leave IPv6
# disabled system-wide. Running them last means a partial failure never changes global
# state.
PostUp   = sysctl -w net.ipv6.conf.all.disable_ipv6=1
PostUp   = sysctl -w net.ipv6.conf.default.disable_ipv6=1
PostDown = sysctl -w net.ipv6.conf.all.disable_ipv6=0
PostDown = sysctl -w net.ipv6.conf.default.disable_ipv6=0

[Peer]
PublicKey = <VPS_PUBLIC_KEY>
Endpoint = <VPS_PUBLIC_IP>:51820

# Route everything into the tunnel. This is what makes it a "full" tunnel and also
# makes wg-quick install a kill-switch (fwmark + policy routing + nftables rules).
AllowedIPs = 0.0.0.0/0

PersistentKeepalive = 25

# --- Verification ---
#
#   sudo wg show              # 'latest handshake' recent, fwmark present
#   curl -4 ifconfig.me       # must print the VPS public IP
#   curl -6 ifconfig.me       # must FAIL (IPv6 blocked, no leak)
#   cat /etc/resolv.conf      # must show the DNS set above
#
# After bringing it down, confirm the system was restored:
#   sysctl net.ipv6.conf.all.disable_ipv6    # back to 0
#   cat /etc/resolv.conf                     # back to the normal resolvers
#
# --- DNS note (Arch / NetworkManager) ---
#
# The DNS directive makes wg-quick call `resolvconf`. Two things are required:
#
#   1. Install the provider:
#        sudo pacman -S openresolv
#
#   2. Hand ownership of /etc/resolv.conf to resolvconf, otherwise NetworkManager keeps
#      rewriting the file and resolvconf refuses to touch it ("signature mismatch"):
#
#        # /etc/NetworkManager/conf.d/rc-manager.conf
#        [main]
#        dns=resolvconf
#        rc-manager=resolvconf
#
#        sudo systemctl restart NetworkManager
#        sudo resolvconf -u
#
#      `dns=` picks the backend; `rc-manager=` decides who owns the file. Setting only
#      the first one appears to work until the next reboot. Validate across a reboot:
#      /etc/resolv.conf must still say "Generated by resolvconf".
#
#      Rollback if DNS breaks:
#        sudo rm /etc/NetworkManager/conf.d/rc-manager.conf
#        sudo systemctl restart NetworkManager
#
# --- Kernel note ---
#
# The kill-switch rules need the nft_fib_ipv4 and nft_ct kernel modules. If `nft`
# reports "Could not process rule: No such file or directory", the running kernel
# probably no longer matches the modules on disk after an upgrade. Compare and reboot:
#   uname -r ; ls /usr/lib/modules/
